#include <stdio.h>
#include <locale.h>

int check(double x, double y) {
    if (y >= 0 && (x * x + y * y <= 36.0) && !(x >= 0 && (x * x + y * y <= 9.0))) {
        return 1;
    }
    return 0;
}

void draw_area() {
    for (double y = 6.0; y >= 0.0; y -= 0.5) {
        for (double x = -6.0; x <= 6.0; x += 0.5) {
            if (check(x, y)) {
                printf("* ");
            } else {
                printf("  ");
            }
        }
        printf("\n");
    }
}

void task() {
    double x, y;
    scanf("%lf %lf", &x, &y);
    printf("%d\n", check(x, y));
    draw_area();
}

void task1() {
    double x;
    scanf("%lf", &x);
    printf("%.4f\n", (x <= 13) ? (-x * x * x + 9.0) : (-3.0 / (x + 1.0)));
}

int main() {
    setlocale(LC_CTYPE, "RUS");
    task();
    task1();
    return 0;
}
